# Docker/Hostinger settings copied from the working server shape.
COMPOSE_PROJECT_NAME=openclaw-voice
PORT=50918
TZ=Europe/Paris

# Set TRAEFIK_ENABLE=true only when this container is behind Traefik.
TRAEFIK_ENABLE=false
TRAEFIK_HOST=example.com

# Required secrets. Keep these in .env only; .env is intentionally ignored by git.
OPENAI_API_KEY=sk-your-openai-key
OPENCLAW_GATEWAY_TOKEN=replace-with-random-token
OPENCLAW_HOOKS_TOKEN=replace-with-random-token
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
ELEVENLABS_API_KEY=replace-with-elevenlabs-key

# Voice mode from the captured setup.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_v3

# Telegram access controls. Numeric Telegram chat/user IDs are safest.
# Example: TELEGRAM_ALLOW_FROM=123456789,987654321
TELEGRAM_ALLOW_FROM=
TELEGRAM_REQUIRE_MENTION=true

# Optional WhatsApp bridge settings. Login still requires pairing inside OpenClaw.
WHATSAPP_ENABLED=true
WHATSAPP_NUMBER=+15555550123
WHATSAPP_ALLOW_FROM=

# Safer defaults than the captured machine. Flip only for trusted local debugging.
OPENCLAW_CONTROL_UI_ALLOW_INSECURE_AUTH=false
OPENCLAW_ELEVATED_TOOLS=false
OPENCLAW_ELEVATED_WEBCHAT_ALLOW_FROM=

# Agent defaults from the captured setup.
OPENCLAW_MODEL_PRIMARY=ChatGPT 5.4
OPENCLAW_THINKING_DEFAULT=low
